{
  "name": "get-nepali-number",
  "version": "0.3.0",
  "description": "Convert any english (Hindu-Arabic) numeral to a Nepali (Devanagari) numeral with Lakh/Crore grouping",
  "license": "MIT",
  "repository": "https://github.com/techgaun/get-nepali-number",
  "author": {
    "name": "techgaun",
    "email": "coolsamar207@gmail.com",
    "url": "https://techgaun.com"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "english-to-nepali",
    "numbers",
    "convert",
    "numeric",
    "conversion",
    "nepali",
    "devanagari",
    "lakh",
    "crore",
    "hindu-arabic",
    "arabic"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
